---
import { NAV_LINKS, PAGES } from "../../config";

const currentPath = Astro.url.pathname;

// Route path segments that don't match their PAGES config key 1:1
const PAGE_KEY_BY_SEGMENT: Record<string, string> = {
    posts: "blog",
};
---

<nav class="navbar">
    <ul class="nav-links">
        {
            NAV_LINKS.filter((link) => {
                const isHome = link.href === "/";
                const segment = link.href.split("/").filter(Boolean)[0];
                const pageKey = isHome
                    ? "home"
                    : PAGE_KEY_BY_SEGMENT[segment] || segment;
                const pageConfig = (PAGES as any)[pageKey];
                return link.isActive !== false && pageConfig?.isActive !== false;
            }).map((link) => (
                <li>
                    <a
                        href={link.href}
                        class={`nav-link ${
                            currentPath === link.href ||
                            (link.href !== "/" &&
                                currentPath.startsWith(link.href))
                                ? "active"
                                : "inactive"
                        }`}
                    >
                        {link.label}
                        <span class="nav-link-line" />
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
